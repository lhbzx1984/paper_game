# OpenAI-compatible chat completions endpoint.
# Leave both blank to run the bundled demo only; you can also fill them from
# the in-app "模型设置" dialog at runtime.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 1 = use the bundled demo case and levels for uploaded papers (no API calls).
# Set to 0 after filling LLM_BASE_URL and LLM_API_KEY.
MOCK_LLM=1

PORT=5173
