# ---------------------------------------------------------------
# 论文解析模型（OpenAI Chat Completions 兼容接口）
# 生产环境推荐直接写在这里，重启后仍然生效。
# ---------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 1 = 使用内置示例案件（不调用模型，不解析上传内容）。
# 正式上线请填 0，并配置上面的 LLM_* 。
MOCK_LLM=1

# ---------------------------------------------------------------
# 服务端
# ---------------------------------------------------------------
PORT=5173
# 不填会自动生成并保存到 data/.secret_key；生产环境建议固定一个随机值。
SECRET_KEY=
# HTTPS 部署时必须为 1；本地 http://127.0.0.1 调试用 0。
# docker-compose.yml 会强制覆盖为 1，所以这里保留 0 也安全。
COOKIE_SECURE=0
# 对外访问地址，用于一人付支付完成后的回跳。
PUBLIC_BASE_URL=https://your-domain.example

# ---------------------------------------------------------------
# 一人付（YiRenFu）次数计费
# 在 https://ai6666.com/opcpay 控制台创建「次数包」产品后填写。
# 服务端凭证只放在这里，不要提交到 Git 或下发到浏览器。
# ---------------------------------------------------------------
YIRENFU_BASE_URL=https://ai6666.com/opcpay/api/pay/v1
YIRENFU_API_KEY=
YIRENFU_WEBHOOK_SECRET=
# 1 = 临时关闭计费（不扣次数、不要求登录）；正式收费保持 0。
BILLING_DISABLED=0

# ---------------------------------------------------------------
# 部署（docker compose / certbot 使用）
# ---------------------------------------------------------------
DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=you@example.com

# 可选：Gunicorn 调优
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=300
